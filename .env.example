# Weakless Automation Engine - environment configuration (docker compose).
# Copy to .env and fill in. Never commit .env.

# --- Required -----------------------------------------------------------------
# Generate the next three with:  python -m app.cli generate-keys   (run in backend/)
WAE_SECRET_KEY=
WAE_MASTER_KEYS=
WAE_ACTIVE_KEY_ID=
# PostgreSQL passwords: owner role (migrations, backups) and application role (API, worker)
WAE_DB_OWNER_PASSWORD=
WAE_DB_PASSWORD=

# --- URLs ---------------------------------------------------------------------
# Externally reachable origin. Webhook URLs and OAuth redirect URIs are built from WAE_PUBLIC_BASE_URL.
WAE_PUBLIC_BASE_URL=http://localhost:3000
WAE_FRONTEND_URL=http://localhost:3000
WAE_HTTP_PORT=3000
# Set to true when serving over HTTPS (Secure cookies + HSTS)
WAE_COOKIE_SECURE=false

# --- First administrator (only used while no SUPER_ADMIN exists) --------------
WAE_BOOTSTRAP_ADMIN_EMAIL=
WAE_BOOTSTRAP_ADMIN_PASSWORD=

# --- Optional: platform-level AI keys (organizations can also connect their own)
WAE_ANTHROPIC_API_KEY=
WAE_OPENAI_API_KEY=
WAE_GEMINI_API_KEY=

# --- Optional: platform email for notifications --------------------------------
WAE_SMTP_HOST=
WAE_SMTP_PORT=587
WAE_SMTP_USERNAME=
WAE_SMTP_PASSWORD=
WAE_SMTP_FROM=

# --- Optional: billing ----------------------------------------------------------
WAE_STRIPE_SECRET_KEY=
WAE_STRIPE_WEBHOOK_SECRET=

# --- Optional: OAuth apps for integrations --------------------------------------
# Redirect URI to register with each provider: <WAE_PUBLIC_BASE_URL>/api/v1/integrations/oauth/callback
WAE_OAUTH_GOOGLE_CLIENT_ID=
WAE_OAUTH_GOOGLE_CLIENT_SECRET=
WAE_OAUTH_MICROSOFT_CLIENT_ID=
WAE_OAUTH_MICROSOFT_CLIENT_SECRET=
WAE_OAUTH_SALESFORCE_CLIENT_ID=
WAE_OAUTH_SALESFORCE_CLIENT_SECRET=
WAE_OAUTH_LINKEDIN_CLIENT_ID=
WAE_OAUTH_LINKEDIN_CLIENT_SECRET=

# --- Optional: operations -------------------------------------------------------
WAE_SENTRY_DSN=
WAE_WORKER_REPLICAS=1
WAE_BACKUP_KEEP_DAYS=14
